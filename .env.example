# Tater OpenAI-compatible provider
TATER_API_BASE_URL='http://localhost:8501/v1'
TATER_API_KEY=''
TATER_BASE_MODEL='tater/base'
TATER_HYDRA_MODEL='tater/hydra'
TATER_CONTEXT_WINDOW=32768
TATER_HYDRA_TIMEOUT_SECONDS=600
TATER_AGENT_MAX_ITERATIONS=32

# Persistent coding projects. Every direct child of this host directory appears
# as a Project, and the selected Project becomes the terminal's default cwd.
TATER_PROJECTS_ROOT='/projects'
TATER_WEBUI_WORKSPACE='/projects'
TATER_WEBUI_HOST_PROJECTS='./projects'

# Keep this stable and private in production.
WEBUI_SECRET_KEY='replace-with-a-long-random-secret'

# Reverse-proxy and privacy defaults
FORWARDED_ALLOW_IPS='*'
CORS_ALLOW_ORIGIN='*'
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
